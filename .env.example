# Server-only Vercel environment variables. Do not add a VITE_ prefix to secrets.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379
POSTURE_PUBLIC_URL=https://YOUR_POSTURE_PROJECT.vercel.app
VIBE_PUBLIC_URL=https://YOUR_VIBE_PROJECT.vercel.app

# Optional: run the production relay locally with bun run dev:relay.
# Set the three variables above to local URLs, then enable Vite's proxy:
# REDIS_URL=redis://127.0.0.1:6379
# POSTURE_PUBLIC_URL=http://localhost:1420
# VIBE_PUBLIC_URL=http://localhost:8081
# POSTURE_CLOUD_RELAY_URL=http://127.0.0.1:1422
