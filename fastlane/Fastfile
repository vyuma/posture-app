default_platform(:mac)
platform :mac do
  desc "Submit the signed macOS package and release automatically after approval"
  lane :store do
    key = app_store_connect_api_key(key_id: ENV.fetch('ASC_KEY_ID'), issuer_id: ENV.fetch('ASC_ISSUER_ID'), key_content: ENV.fetch('ASC_PRIVATE_KEY'))
    upload_to_app_store(api_key: key, app_identifier: 'com.kyoungpin.piiin', platform: 'osx',
      pkg: ENV.fetch('PIIIN_STORE_PKG'), app_version: ENV.fetch('RELEASE_TAG').delete_prefix('v'),
      skip_metadata: true, skip_screenshots: true, submit_for_review: true,
      automatic_release: true, force: true, precheck_include_in_app_purchases: false)
  end
end
