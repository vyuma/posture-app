{
  "name": "posture-app",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:anago-lottie": "node scripts/build-anago-overlay-lottie.mjs && node scripts/build-anago-expression-lottie.mjs",
    "test:anago-lottie": "node --test scripts/anago-lottie.test.mjs",
    "build": "tsc && vite build",
    "build:debug-ui": "VITE_SHOW_DEBUG_UI=true tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:debug-ui": "VITE_SHOW_DEBUG_UI=true bun run tauri build",
    "release:macos": "node scripts/release-macos.mjs",
    "test:updates": "bun test scripts/desktop-updater.test.tsx",
    "test:overlay-position": "bun test scripts/overlay-position.test.tsx",
    "test:work": "bun test scripts/work-session.test.ts",
    "build:store": "VITE_DISTRIBUTION_CHANNEL=mac-app-store bun run build && node scripts/prepare-store-posture-assets.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json && vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "deploy:web": "cf deploy --prebuilt",
    "test:accounts": "bun test scripts/accounts.test.ts && bun test scripts/outbox.test.ts",
    "test:server": "node --experimental-strip-types scripts/server.test.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.18",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "better-auth": "1.7.18",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "0.45.4",
    "html-to-image": "^1.11.13",
    "lottie-web": "^5.13.0",
    "mediabunny": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@cloudflare/workers-types": "5.20261108.1",
    "@tauri-apps/cli": "^2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "cf": "1.0.0-beta.28",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "21.0.4",
    "miniflare": "5.20261101.0-beta",
    "typescript": "~5.8.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "overrides": {
    "@babel/core": "7.29.13",
    "browserslist": "4.29.5",
    "baseline-browser-mapping": "2.11.35",
    "nanoid": "3.3.20",
    "postcss": "8.5.32",
    "source-map-js": "1.2.2"
  }
}
