{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiiiN",
  "version": "0.1.4",
  "identifier": "com.vyuma.posture-app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PiiiN",
        "width": 1200,
        "height": 780,
        "visible": false,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBMTlENTI0QUIzQjhCQjQKUldTMGl6dXJKTlVaU213Vk1QVTNsdW1OWGhqcC8yMmtNcnJ6S3p5UlBuSW5UR01zanhadExpV1YK",
      "endpoints": [
        "https://github.com/vyuma/posture-app/releases/latest/download/latest.json"
      ]
    }
  }
}
